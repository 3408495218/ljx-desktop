# 垃圾侠桌面端 · 仓库忽略规则

# ---------- 前端依赖与构建产物 ----------
node_modules/
dist/
dist-ssr/
*.local

# ---------- Rust 构建缓存 ----------
# 裸 `target/` 而不是 `src-tauri/target`：后者只能匹配第一层，
# 匹配不到 vendor 里嵌套的（src-tauri/vendor/crust_core/target/，
# 单个 .rlib 就上百 MB）。
target/

# Tauri 2 生成的 schema，构建时自动重建
src-tauri/gen/schemas/

# ---------- 本地联调用的服务端 jar ----------
# 大体积 Paper 服务端（单个 48MB），不进仓库
test-server/

# ---------- 凭据（绝不提交）----------
# 平台地址与令牌都存在用户目录（com.ljx.desktop/），不在仓库内；
# 下面这些是万一有人本地建了对应文件时的兜底。
.env
.env.*
*.pem
*.key
*.p12
*credential*
*secret*

# ---------- 编辑器 / 系统 ----------
.idea/
.vscode/
*.iml
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志 ----------
*.log
logs/

# ---------- 本地打包的发行包 ----------
# 安装包体积大且可随时重新构建，只留在本地
发行包/
